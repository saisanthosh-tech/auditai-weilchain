# ====================================
# AuditAI - Environment Configuration
# ====================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Weilchain ---
WEILCHAIN_RPC_URL=https://rpc.weilchain.io
WEILCHAIN_CHAIN_ID=1
WEILCHAIN_WALLET_KEY=
WEILCHAIN_WALLET_ADDRESS=

# --- Weilliptic SDK ---
WEILLIPTIC_API_KEY=
WEILLIPTIC_API_URL=https://api.weilliptic.ai
WEILLIPTIC_APPLET_ID=

# --- Audit Logging ---
AUDIT_LOG_LEVEL=detailed
AUDIT_ON_CHAIN=true
AUDIT_LOCAL_FILE=true
AUDIT_LOCAL_FILE_PATH=./logs/audit.jsonl

# --- Agent Behavior ---
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=false

# --- MCP Tools ---
NEWS_FEED_API_KEY=
